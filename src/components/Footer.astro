---
// src/components/Footer.astro
const socials = [
  { label: 'Instagram', icon: 'M7 2C4.24 2 2 4.24 2 7v10c0 2.76 2.24 5 5 5h10c2.76 0 5-2.24 5-5V7c0-2.76-2.24-5-5-5H7zm10 2c1.66 0 3 1.34 3 3v10c0 1.66-1.34 3-3 3H7c-1.66 0-3-1.34-3-3V7c0-1.66 1.34-3 3-3h10zm-5 3.5A5.5 5.5 0 1 0 17.5 13 5.51 5.51 0 0 0 12 7.5zm0 2A3.5 3.5 0 1 1 8.5 13 3.5 3.5 0 0 1 12 9.5zM18 6a1 1 0 1 0 1 1 1 1 0 0 0-1-1z' },
  { label: 'LinkedIn',  icon: 'M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zM8 19h-3v-9h3v9zM6.5 8.25c-1 0-1.75-.75-1.75-1.75s.75-1.75 1.75-1.75 1.75.75 1.75 1.75-.75 1.75-1.75 1.75zM20 19h-3v-4.5c0-1.1-.9-2-2-2s-2 .9-2 2V19h-3v-9h3v1.5c.6-1 1.8-1.5 3-1.5 2.2 0 4 1.8 4 4V19z' },
  { label: 'Email',     icon: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z' },
];

const links1 = [
  ['Sobre él', '#sobre-el'],
  ['Trayectoria', '#trayectoria'],
  ['Valores', '#valores'],
];
const links2 = [
  ['Equipo', '#equipo'],
  ['Noticias', '#noticias'],
  ['Contacto', '#contacto'],
];
---
<footer class="bg-[#0a2540] text-white">
  <div class="max-w-7xl mx-auto px-6 pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-4">
          <a href="#" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#2dd4ff] to-[#14366b] flex items-center justify-center text-white font-black text-lg shadow-lg">
        <img src="/img/logo-pettigiani.webp">
      </div>
      <div class="leading-tight">
        <div class="font-bold text-white text-sm tracking-tight">Pettigiani</div>
        <div class="text-[10px] text-[#9fd8ff] uppercase tracking-widest font-medium">Fiscal</div>
      </div>
    </a>
        </div>
        <p class="text-white/50 text-sm leading-relaxed max-w-sm">
          Sitio profesional de Juan Manuel Pettigiani, Fiscal en General Pueyrredon.
          Información institucional, trayectoria y contacto.
        </p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Navegación</h4>
        <ul class="space-y-2.5">
          {links1.map(([label, href]) => (
            <li><a href={href} class="text-sm text-white/50 hover:text-[#2dd4ff] transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Información</h4>
        <ul class="space-y-2.5">
          {links2.map(([label, href]) => (
            <li><a href={href} class="text-sm text-white/50 hover:text-[#2dd4ff] transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>
    </div>



      <div class="mt-10 pt-6  border-t border-black/10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs text-white/35">
       &copy; {new Date().getFullYear()} Juan Manuel Pettigiani — Sitio profesional. Contenido con fines ilustrativos.
    </p>

    <div class="flex items-center gap-2">

      <a
          href=""
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-black/20 ring-1 ring-black/20 text-white/90 hover:bg-gradient-to-br hover:from-[#833AB4] hover:via-[#E1306C] hover:to-[#FCAF45] hover:text-white transition-all duration-300"
      >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="h-4 w-4 fill-current"
            aria-hidden="true"
        >
          <path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z"/>
        </svg>
      </a>




      <a
          href="https://github.com/mardel-studios"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-black/20 ring-1 ring-black/20 text-white/90 hover:bg-black hover:text-white transition-all duration-300"
      >
       <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
	<path d="M0 0h24v24H0z" fill="none" />
	<path fill="current" d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2" />
</svg>

      </a>

    </div>

  </div>

  </div>
</footer>
